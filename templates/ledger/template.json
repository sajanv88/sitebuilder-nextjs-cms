{
  "slug": "ledger",
  "name": "Ledger",
  "version": "1.0.0",
  "description": "For an accountant or an advisory firm: a sober, ruled look with its own header and page layout, client notes, and Services with fees, About and Contact.",
  "author": "Sitebuilder",
  "licence": "GPL-2.0-or-later",
  "requires": {
    "sitebuilder": "^0.1.0",
    "nuvui": "^0.8.0"
  },
  "theme": {
    "preset": "ledger",
    "mode": "light",
    "density": "default",
    "tokens": {}
  },
  "screenshots": [
    {
      "file": "screenshots/home-desktop.png",
      "label": "The home page on a computer"
    },
    {
      "file": "screenshots/home-phone.png",
      "label": "The home page on a phone"
    }
  ],
  "components": {
    "site": "components/Site.tsx",
    "page": "components/Page.tsx"
  },
  "styles": {
    "entry": "styles/main.scss"
  },
  "options": [
    {
      "key": "ruled",
      "type": "boolean",
      "label": "Rule a line under page titles",
      "description": "A double line, as at the foot of a column of figures.",
      "default": true
    },
    {
      "key": "width",
      "type": "choice",
      "label": "Page width",
      "description": "How wide the text column runs on a large screen.",
      "choices": [
        {
          "value": "narrow",
          "label": "Narrow, for reading"
        },
        {
          "value": "wide",
          "label": "Wide, for tables and columns"
        }
      ],
      "default": "narrow"
    }
  ],
  "blocks": [
    {
      "name": "client-note",
      "label": "Client note",
      "description": "A client's words about your work, with their name and role, ruled like a ledger entry.",
      "category": "marketing",
      "icon": "message",
      "component": "components/blocks/ClientNote.tsx",
      "fields": [
        {
          "name": "quote",
          "label": "What they said",
          "kind": "text",
          "max": 300
        },
        {
          "name": "name",
          "label": "Name",
          "kind": "text",
          "max": 80
        },
        {
          "name": "role",
          "label": "Role and company",
          "kind": "text",
          "max": 80,
          "optional": true
        },
        {
          "name": "photoMediaId",
          "label": "Photo",
          "kind": "media",
          "accept": "image",
          "optional": true
        }
      ],
      "defaults": {
        "quote": "What a client said about working with you.",
        "name": "Client name"
      },
      "summaryField": "name"
    }
  ],
  "starter": "content/starter.json"
}
