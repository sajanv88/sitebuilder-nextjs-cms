# Copy to .env (git-ignored) and fill in AUTH_SECRET. compose.yaml and `pnpm dev` both read it.
# In Kubernetes these come from the chart's ConfigMap and an existing Secret, never from a file.

# Local development against compose.dev.yaml's Postgres. Inside compose the app services
# use the `postgres` host instead.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/sitebuilder

# At least 32 characters. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# The public address of the site, as visitors type it.
SITE_URL=http://localhost:3000

# local or s3. s3 also needs S3_ENDPOINT, S3_BUCKET, S3_REGION, S3_ACCESS_KEY_ID,
# S3_SECRET_ACCESS_KEY and S3_PUBLIC_URL (see the README).
MEDIA_STORAGE=local
