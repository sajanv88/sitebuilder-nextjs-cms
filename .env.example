# Copy to .env (git-ignored) and fill in AUTH_SECRET. compose.yaml and `pnpm dev` both read it.
# In Kubernetes these come from the chart's ConfigMap and an existing Secret, never from a file.

# Local development against compose.dev.yaml's Postgres. Inside compose the app services
# use the `postgres` host instead.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/sitebuilder

# At least 32 characters. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# The public address of the site, as visitors type it.
SITE_URL=http://localhost:3000

# Where uploads go when no admin has chosen in Settings → Media storage: local or s3.
# A choice saved in Settings wins over these.
MEDIA_STORAGE=local

# Local storage's folder. Compose mounts the media volume here. For `pnpm dev`, point it at a
# git-ignored folder, such as the absolute path of this repo's .media/.
MEDIA_LOCAL_DIR=/data/media

# At least 32 characters. Lets a cron service call /api/cron/publish (Vercel Cron, system cron);
# the admin publishes scheduled posts by itself, so this is optional.
# CRON_SECRET=

# The header holding the visitor's address, for the per-IP sign-in limit. Trust it only when a
# reverse proxy in front of the site overwrites it (Caddy, nginx, Traefik do for X-Forwarded-For).
# CLIENT_IP_HEADER=x-forwarded-for

# Lets the AI assistant (Settings → AI) reach an address on this machine or your network, such as
# Ollama at http://localhost:11434. Off by default: only https addresses on the internet.
# AI_ALLOW_PRIVATE_URLS=true

# For MEDIA_STORAGE=s3 (MinIO, Cloudflare R2, AWS S3 and the like):
# S3_ENDPOINT=https://minio.example.com
# S3_BUCKET=site-media
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
