{
  "name": "sitebuilder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check . && stylelint \"**/*.scss\" --allow-empty-input",
    "lint:fix": "biome check --write . && stylelint \"**/*.scss\" --allow-empty-input --fix",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @sitebuilder/db db:generate",
    "db:check": "pnpm --filter @sitebuilder/db db:check",
    "db:migrate": "pnpm --filter @sitebuilder/db db:migrate",
    "db:seed": "pnpm --filter @sitebuilder/db db:seed",
    "db:studio": "pnpm --filter @sitebuilder/db db:studio",
    "check:licence": "node scripts/check-licence.ts",
    "licence-list": "node scripts/licences.ts",
    "sitebuilder": "pnpm --silent --filter @sitebuilder/cli build && node packages/cli/dist/sitebuilder.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "postcss": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "turbo": "2.11.9"
  },
  "license": "GPL-2.0-or-later",
  "author": "Sajankumar Vijayan"
}
